#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
plugin_root="$(cd "$script_dir/.." && pwd)"
skill_content="$(<"$plugin_root/skills/smol-activate/SKILL.md")"

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

context="<EXTREMELY_IMPORTANT>
smolpowers:smol-activate bootstrap

The smol-activate skill is loaded below. Apply its configured activation level. Invoke exactly one phase owner only when the request qualifies.

${skill_content}
</EXTREMELY_IMPORTANT>"

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
  "$(json_escape "$context")"
